{
  "expo": {
    "name": "Cuseum Scanner",
    "slug": "cuseum-scanning-app",
    "scheme": "cuseum-scanner",
    "version": "1.0.8",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "cover",
      "backgroundColor": "#0d7377"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cuseum.scannerapp",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Cuseum Scanner uses the camera to scan membership barcodes and QR codes at museum entry points to verify and record member attendance.",
        "NSMicrophoneUsageDescription": "Cuseum Scanner requires microphone access as part of the camera framework used to scan membership barcodes at museum entry points."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0d7377"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.cuseum.scanner"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-camera",
      "./plugins/withJanamScanner"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c0e4246a-3fa7-4998-8f06-8d5c52ab4189"
      }
    }
  }
}
